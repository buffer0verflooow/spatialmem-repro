<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- API 34+ 才强制要求；minSdk 29 时低版本系统自动忽略该权限。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <!-- 同上：API 34+ 采集麦克风的前台服务类型权限；真机 API 32 不强制。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="true" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <!--
          官方 VideoShowCase 眼镜端 App 的雷鸟 Mercury 应用标记：
          让系统把本应用当作一等公民，避免 BackgroundAppManager 在前台切换时
          force-stop（实测手动点图标会被雷鸟桌面抢前台后强杀）。
        -->
        <meta-data
            android:name="com.rayneo.mercury.app"
            android:value="true" />

        <!--
            极简状态 Activity（docs/archive/工单-M1-03-打回4-Activity不能finish.md 第 3 节）：读目标 IP → 起前台服务 →
            保持在前台不 finish，用可见窗口 + KEEP_SCREEN_ON 换取相机进程优先级。
        -->
        <activity
            android:name=".GlassLinkActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".GlassLinkService"
            android:exported="false"
            android:foregroundServiceType="camera|microphone" />
    </application>

</manifest>
