# linksee-server 生产部署环境变量
# 使用方式：
#   export IMAGE_TAG=$(git rev-parse --short HEAD)
#   docker compose --env-file .env.docker up -d
#
# IMAGE_TAG 默认值为 dev，生产环境必须指定具体的 commit hash。
#
# 生成密钥：openssl rand -hex 32

# ---- 运行模式 ----
ENV=prod
LOG_LEVEL=INFO

# ---- 接入层 ----
# ！！必须修改：设备共享密钥，与眼镜端固件一致
DEVICE_SHARED_SECRET=change-me-to-a-random-secret
WS_HEARTBEAT_TIMEOUT_S=30

# ---- 帧准入闸门 ----
GATE_RATE_LIMIT_PER_SEC=1.0
GATE_PHASH_DUP_DISTANCE=8
GATE_MIN_INTERVAL_S=3.0
GATE_FORCE_DISTANCE=16
GATE_READ_RATE_PER_MIN=6.0
GATE_READ_BURST=3.0

# ---- 推理层 ----
# ！！必须修改：切换到真实模型后端并填入 API Key
INFERENCE_BACKEND=mock
DASHSCOPE_API_KEY=sk-your-api-key-here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VL_MODEL=qwen-vl-plus
VL_TIMEOUT_S=10.0
VL_RETRIES=1
VL_MAX_TOKENS=300
IMAGE_MAX_EDGE=1024
IMAGE_JPEG_QUALITY=75

# ---- 阅读模式 ----
OCR_MODEL=qwen-vl-ocr
OCR_TIMEOUT_S=15.0
OCR_MAX_TOKENS=2048
OCR_MAX_CHARS=2000

# ---- RAG 旁路 ----
# 设为 chroma 启用知识库检索（需先执行 kb_ingest.py 入库）
KB_BACKEND=null
KB_DIR=/app/data/kb/current
KB_TOP_K=3
KB_MIN_SCORE=0.7
KB_CTX_TTL_S=60

# ---- 存储 ----
KV_BACKEND=redis
REDIS_URL=redis://redis:6379/0
# 设为 mysql 启用推理日志持久化
DB_BACKEND=null
MYSQL_DSN=mysql+aiomysql://linksee:linksee@mysql:3306/linksee

# ---- 结果整形 ----
REPLY_MAX_CHARS=30

# ---- 延迟预算 ----
HARD_DEADLINE_S=5.0

# ---- 规则层 ----
FACE_DETECT_ENABLED=false

# ---- 基础设施 ----
LINKSEE_PORT=8000
REDIS_PORT=6379
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=change-me-to-a-random-password
