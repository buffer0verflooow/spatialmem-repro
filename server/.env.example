# 复制为 .env 后按需修改。所有阈值均可热更新（POST /admin/config/reload）
ENV=dev
LOG_LEVEL=INFO

# ---------- 接入层 ----------
DEVICE_SHARED_SECRET=dev-secret-change-me
WS_HEARTBEAT_TIMEOUT_S=30

# ---------- 帧准入闸门（§5.1，成本的主控开关）----------
GATE_RATE_LIMIT_PER_SEC=1.0
GATE_PHASH_DUP_DISTANCE=8
GATE_MIN_INTERVAL_S=3.0
GATE_FORCE_DISTANCE=16
# 阅读模式独立令牌桶：单次阅读的输出 token 是普通帧的 20-30 倍，连按会烧钱。
# 独立于上面的实时帧限流，两者互不挤占。
GATE_READ_RATE_PER_MIN=6.0
GATE_READ_BURST=3.0

# ---------- 推理层 ----------
# mock = 不调外部 API，本地确定性假响应；dashscope = 真实调用
INFERENCE_BACKEND=mock
MOCK_LATENCY_MS=0
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VL_MODEL=qwen-vl-plus
VL_TIMEOUT_S=10.0
VL_RETRIES=1
VL_MAX_TOKENS=300
IMAGE_MAX_EDGE=1024
IMAGE_JPEG_QUALITY=75

# ---------- 阅读模式（trigger=read）----------
# 专用 OCR 档位：qwen-vl-plus 做长文本转录会幻觉（编出图上没有的内容）。
# 这条路径脱离 P50<=1.5s 预算——用户主动发起，愿意等。
OCR_MODEL=qwen-vl-ocr
OCR_TIMEOUT_S=15.0
OCR_RETRIES=1
OCR_MAX_TOKENS=2048
# 全文上限，超出截断：不截断会产生几百条分片消息
OCR_MAX_CHARS=2000

# ---------- RAG 旁路 ----------
# null = 上下文恒为空（不装 chromadb 也能跑）；chroma = 真实检索
KB_BACKEND=null
KB_DIR=data/kb/current
KB_TOP_K=3
KB_MIN_SCORE=0.7
KB_CTX_TTL_S=60

# ---------- 存储 ----------
# memory = 进程内 KV（仅单 worker / 测试）；redis = 生产
KV_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
# null = 不落库；mysql = 真实持久化
DB_BACKEND=null
MYSQL_DSN=mysql+aiomysql://root:root@localhost:3306/linksee

# ---------- 结果整形 ----------
REPLY_MAX_CHARS=30

# ---------- 延迟预算（§6）----------
HARD_DEADLINE_S=5.0

# ---------- 结构化观察（客户端空间记忆 /v1/observe）----------
OBSERVE_MODEL=qwen-vl-max
OBSERVE_TIMEOUT_S=20.0
OBSERVE_MAX_TOKENS=200
OBSERVE_MAX_FRAME_BYTES=10485760

# ---------- 安全 ----------
DEVICE_AUTH_MODE=hmac
AGENT_API_KEYS=
ADMIN_API_KEY=
FIELD_ENCRYPTION_KEY=
FIELD_ENCRYPTION_ENABLED=false

# ---------- Agent（物品识别）----------
AGENT_MAX_TOOL_ROUNDS=3
AGENT_MODEL=qwen-vl-plus
AGENT_INJECTION_GUARD_ENABLED=true
AGENT_RATE_LIMIT_PER_SESSION=10
AGENT_RATE_LIMIT_PER_IP=30
AGENT_MAX_SESSIONS_PER_IP=5
AGENT_OUTPUT_MAX_CHARS=5000
