# 复制为 .env 后按需修改。
ENV=dev
LOG_LEVEL=INFO

# mock = 不调外部 API，本地确定性假响应；dashscope = 真实调用
INFERENCE_BACKEND=mock
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OBSERVE_MODEL=qwen-vl-max
OBSERVE_TIMEOUT_S=20
OBSERVE_MAX_TOKENS=200
OBSERVE_MAX_FRAME_BYTES=10485760
